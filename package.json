{
  "name": "@jinni-labs/ui",
  "version": "0.0.1",
  "description": "Web React UI Component Library",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/components/*/index.js",
      "types": "./dist/components/*/index.d.ts"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "types": "./dist/hooks/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    },
    "./constants": {
      "import": "./dist/constants/index.js",
      "types": "./dist/constants/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hyejinny97/Jinni-UI"
  },
  "bugs": {
    "email": "yhj970102@gmail.com"
  },
  "keywords": [
    "react",
    "ui",
    "component"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/generateIndex.ts && vite build && tsx scripts/generateTypes.ts",
    "preview": "vite preview",
    "prepare": "husky",
    "type-check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "type-check:save": "tsc -p tsconfig.app.json --noEmit --extendedDiagnostics --pretty false 2>&1 | tee tsc-errors.txt",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint"
    ]
  },
  "dependencies": {
    "classnames": "^2.5.1"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "3.2.2",
    "@eslint/js": "^9.13.0",
    "@storybook/addon-essentials": "8.4.0",
    "@storybook/addon-interactions": "8.4.0",
    "@storybook/addon-onboarding": "8.4.0",
    "@storybook/blocks": "8.4.0",
    "@storybook/react": "8.4.0",
    "@storybook/react-vite": "8.4.0",
    "@storybook/test": "8.4.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/eslint-plugin-jsx-a11y": "^6",
    "@types/node": "^22.8.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/ui": "2.1.4",
    "chromatic": "^13.3.4",
    "eslint": "^9.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.13",
    "eslint-plugin-storybook": "^0.10.1",
    "globals": "^15.11.0",
    "husky": "^9.1.6",
    "jsdom": "^27.0.0",
    "lint-staged": "^15.2.10",
    "motion": "^12.40.0",
    "prettier": "^3.3.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sass-embedded": "^1.80.6",
    "storybook": "8.4.0",
    "tsx": "^4.23.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.10.0",
    "vite": "^5.4.9",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^2.1.4"
  },
  "packageManager": "yarn@4.5.1",
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
